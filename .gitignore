# ═══════════════════════════════════════════════════════════
#  a2n .gitignore
#
#  ⚠️ 这个文件是安全边界，不要随意删减。
#     .a2n_cookies.json 里有 MUSIC_U 会话主凭证（770 字符），
#     一旦提交上去，任何人都能直接接管你的网易云账号。
# ═══════════════════════════════════════════════════════════

# ── 凭证：绝对禁止入库 ──
.a2n_cookies.json
.a2n_cache.json
*.cookies.json
cookies*.json
qr-*.png

# ── 隐私数据：含你的听歌记录、uid、昵称 ──
reports/
*.csv

# ── 运行产物 ──
*.log
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ── 编辑器 / 系统 ──
.vscode/
.idea/
.DS_Store
*.swp

# ── 本机专用脚本（含个人账号信息，不进仓库） ──
推送.sh
